# Copy to .env to override the defaults in src/review_sentiment/core/config.py
SENTIMENT_ENVIRONMENT=dev
SENTIMENT_LOG_LEVEL=INFO
# Serve a specific trained version instead of the latest one:
# SENTIMENT_MODEL_VERSION=20261124-100458
SENTIMENT_MAX_REVIEW_CHARS=5000
SENTIMENT_MAX_BATCH_SIZE=100
SENTIMENT_CORS_ORIGINS=["http://localhost:5173"]
